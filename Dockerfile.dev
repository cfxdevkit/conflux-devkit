# ============================================================================
# Conflux DevKit - Development Dockerfile
# Optimized for development with hot reloading and debugging tools
# ============================================================================

# Use Debian Bookworm as base (includes OpenSSL 3.0)
FROM node:20-bookworm-slim

# Set working directory
WORKDIR /workspaces/conflux-devkit

# Install system dependencies and development tools
RUN apt-get update && apt-get install -y \
    # OpenSSL 3.0 and crypto libraries
    libssl3 \
    libcrypto3 \
    # Build tools for native modules
    build-essential \
    python3 \
    python3-pip \
    make \
    g++ \
    gcc \
    # Development utilities
    jq \
    curl \
    wget \
    git \
    vim \
    nano \
    htop \
    tree \
    unzip \
    zip \
    tar \
    gzip \
    # Network utilities
    net-tools \
    iputils-ping \
    netcat-openbsd \
    telnet \
    traceroute \
    tcpdump \
    # Process utilities
    procps \
    psmisc \
    lsof \
    strace \
    ltrace \
    # System monitoring and debugging
    iotop \
    iostat \
    sar \
    sysstat \
    dstat \
    # File and text utilities
    less \
    more \
    grep \
    sed \
    awk \
    findutils \
    coreutils \
    util-linux \
    # Additional debugging tools
    gdb \
    valgrind \
    # Network debugging
    tcpflow \
    ngrep \
    # Database and storage tools
    sqlite3 \
    # Additional libraries that might be needed
    libc6-dev \
    libstdc++6 \
    # Clean up
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install global Node.js tools
RUN npm install -g \
    pnpm \
    pm2 \
    tsx \
    typescript \
    @types/node \
    nodemon \
    concurrently \
    @biomejs/biome \
    vitest

# Copy package files
COPY package*.json ./
COPY pnpm-lock.yaml* ./

# Install dependencies
RUN pnpm install

# Copy source code
COPY . .

# Create logs directory
RUN mkdir -p logs

# Expose ports
EXPOSE 3001 3002 3003 12537 8545 9229

# Set environment variables for development
ENV NODE_ENV=development
ENV PORT=3001
ENV STATE_SERVER_URL=ws://localhost:3002
ENV VITE_API_BASE_URL=http://localhost:3001/api
ENV VITE_WS_URL=ws://localhost:3002

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:3001/api/health || exit 1

# Default command - start development mode
CMD ["pnpm", "run", "dev"]
