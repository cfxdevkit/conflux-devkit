{
  "name": "conflux-devkit",
  "version": "0.1.2",
  "description": "Conflux Development Kit - Professional monorepo for blockchain development",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "format:fix": "turbo run format:fix",
    "check": "turbo run check",
    "check:fix": "turbo run check:fix",
    "check:fix:unsafe": "turbo run check:fix:unsafe",
    "dev": "turbo run dev",
    "start": "bash scripts/service-manager.sh start",
    "start:dev": "bash scripts/service-manager.sh start:dev",
    "start:prod": "bash scripts/service-manager.sh start:prod",
    "start:docker": "bash scripts/service-manager.sh start:docker",
    "stop": "bash scripts/service-manager.sh stop",
    "stop:dev": "bash scripts/service-manager.sh stop:dev",
    "stop:prod": "bash scripts/service-manager.sh stop:prod",
    "stop:docker": "bash scripts/service-manager.sh stop:docker",
    "restart": "bash scripts/service-manager.sh restart",
    "restart:dev": "bash scripts/service-manager.sh restart:dev",
    "restart:prod": "bash scripts/service-manager.sh restart:prod",
    "restart:docker": "bash scripts/service-manager.sh restart:docker",
    "restart:force": "bash scripts/service-manager.sh restart:force",
    "status": "bash scripts/service-manager.sh status",
    "health": "bash scripts/service-manager.sh health",
    "cleanup": "bash scripts/service-manager.sh cleanup",
    "logs": "bash scripts/service-manager.sh logs",
    "checkpoint": "node scripts/enhanced-checkpoint.js",
    "checkpoint:legacy": "node scripts/checkpoint.js",
    "checkpoint:silent": "node scripts/enhanced-checkpoint.js --silent",
    "checkpoint:quick": "node scripts/enhanced-checkpoint.js --skip-tests --skip-build",
    "changelog": "node scripts/enhanced-changelog.js",
    "changelog:legacy": "node scripts/changelog.js",
    "changelog:add": "node scripts/enhanced-changelog.js add",
    "changelog:checkpoint": "node scripts/enhanced-changelog.js checkpoint",
    "version": "node scripts/version-manager.js",
    "version:patch": "node scripts/version-manager.js patch",
    "version:minor": "node scripts/version-manager.js minor",
    "version:major": "node scripts/version-manager.js major",
    "version:auto": "node scripts/version-manager.js auto",
    "version:info": "node scripts/version-manager.js info",
    "commit:hook": "node scripts/commit-hook.js",
    "commit:install": "node scripts/commit-hook.js install",
    "commit:uninstall": "node scripts/commit-hook.js uninstall",
    "commit:pre": "node scripts/commit-hook.js pre-commit",
    "commit:post": "node scripts/commit-hook.js post-commit",
    "package-map": "node scripts/package-map.js",
    "dev:node": "turbo run dev --filter=@conflux-devkit/node",
    "dev:backend": "turbo run dev --filter=@conflux-devkit/backend",
    "dev:frontend": "turbo run dev --filter=@conflux-devkit/frontend",
    "dev:all": "turbo run dev --parallel",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs",
    "interactive": "bash scripts/interactive-manager.sh",
    "docker:build": "docker build -t conflux-devkit .",
    "docker:build:dev": "docker build -f Dockerfile.dev -t conflux-devkit:dev .",
    "docker:run": "docker run -p 3001:3001 -p 3002:3002 -p 3003:3003 -p 12537:12537 -p 8545:8545 conflux-devkit",
    "docker:run:dev": "docker run -p 3001:3001 -p 3002:3002 -p 3003:3003 -p 12537:12537 -p 8545:8545 -v $(pwd):/workspaces/conflux-devkit conflux-devkit:dev",
    "docker:services": "bash scripts/docker-services.sh",
    "docker:start": "bash scripts/docker-services.sh start",
    "docker:stop": "bash scripts/docker-services.sh stop",
    "docker:restart": "bash scripts/docker-services.sh restart",
    "docker:status": "bash scripts/docker-services.sh status",
    "docker:logs": "bash scripts/docker-services.sh logs",
    "docker:cleanup": "bash scripts/docker-services.sh cleanup",
    "generate:contracts": "node scripts/generate-contract-config.cjs",
    "contracts:sync": "pnpm run generate:contracts",
    "postinstall": "pnpm run generate:contracts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@swc/core": "^1.13.5",
    "@types/node": "^20.19.17",
    "concurrently": "^9.2.1",
    "pm2": "^6.0.13",
    "tsx": "^4.20.5",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "keywords": [
    "conflux",
    "blockchain",
    "development",
    "monorepo",
    "devkit",
    "node",
    "evm",
    "core"
  ],
  "author": "Conflux Development Team",
  "license": "MIT",
  "dependencies": {
    "@xcfx/node": "^0.6.0",
    "cive": "^0.8.1"
  }
}
