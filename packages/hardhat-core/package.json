{
  "name": "@conflux-devkit/hardhat-core",
  "version": "0.1.0",
  "description": "Hardhat configuration and artifacts management for Conflux Core blockchain",
  "type": "commonjs",
  "main": "index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./index.js",
      "import": "./index.js"
    },
    "./hardhat.config": "./hardhat.config.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "hardhat compile",
    "clean": "hardhat clean",
    "deploy": "hardhat run scripts/deploy.js",
    "deploy:testnet": "hardhat run scripts/deploy.js --network cfxtest",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network cfx",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "size": "hardhat size-contracts",
    "node": "hardhat node",
    "console": "hardhat console"
  },
  "dependencies": {
    "@types/node-fetch": "^2.6.13",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@civex/hardhat-cive": "^0.0.2",
    "@types/node": "^20.0.0",
    "axios": "^1.7.9",
    "cive": "^0.8.1",
    "hardhat": "^2.22.17",
    "hardhat-gas-reporter": "^2.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "conflux",
    "core",
    "hardhat",
    "blockchain",
    "smart-contracts",
    "devkit"
  ],
  "author": "Conflux DevKit",
  "license": "MIT"
}