{
  "name": "@conflux-devkit/hardhat-espace",
  "version": "0.1.0",
  "description": "Hardhat configuration and artifacts management for Conflux eSpace (EVM) blockchain",
  "type": "commonjs",
  "main": "index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./index.js",
      "import": "./index.js"
    },
    "./hardhat.config": "./hardhat.config.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "hardhat compile",
    "clean": "hardhat clean",
    "deploy": "hardhat run scripts/deploy.js",
    "deploy:testnet": "hardhat run scripts/deploy.js --network cfxtestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network cfxmainnet",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "size": "hardhat size-contracts",
    "node": "hardhat node",
    "console": "hardhat console"
  },
  "dependencies": {
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition-viem": "^0.15.8",
    "@nomicfoundation/hardhat-toolbox-viem": "^3.0.0",
    "@types/node": "^20.0.0",
    "hardhat": "^2.22.17",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "conflux",
    "espace",
    "evm",
    "hardhat",
    "blockchain",
    "smart-contracts",
    "devkit",
    "viem"
  ],
  "author": "Conflux DevKit",
  "license": "MIT"
}