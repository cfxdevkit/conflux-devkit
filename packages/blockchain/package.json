{
  "name": "@conflux-devkit/blockchain",
  "version": "1.0.0",
  "description": "Conflux Development Kit Blockchain - Pure blockchain operations and wallet management",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser/browser.mjs",
      "types": "./dist/browser/browser.d.mts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest --run",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:ci": "vitest run --coverage --reporter=verbose",
    "clean": "rm -rf dist",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format src/",
    "format:fix": "biome format --write src/",
    "check": "biome check src/",
    "check:fix": "biome check --write src/",
    "check:fix:unsafe": "biome check --write --unsafe src/",
    "checkpoint": "echo \"Checkpoint: @conflux-devkit/blockchain - All checks passed\""
  },
  "dependencies": {
    "@conflux-devkit/core": "workspace:*",
    "@xcfx/node": "^0.6.0",
    "bip32": "^4.0.0",
    "bip39": "^3.1.0",
    "cive": "^0.8.1",
    "fs-extra": "^11.2.0",
    "tiny-secp256k1": "^2.2.4",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.0.0",
    "@vitest/ui": "^3.2.4",
    "c8": "^10.1.3",
    "tsup": "^8.0.2",
    "tsx": "^4.20.5",
    "typescript": "^5.2.2",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "conflux",
    "blockchain",
    "wallet",
    "transaction",
    "contract",
    "operations"
  ],
  "author": "Conflux Development Team",
  "license": "MIT",
  "packageManager": "pnpm@10.11.0"
}
