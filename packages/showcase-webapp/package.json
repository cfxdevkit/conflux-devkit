{
  "name": "@conflux-devkit/showcase-webapp",
  "version": "1.0.0",
  "description": "Complete workspace management dashboard for Conflux DevKit",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "start": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "test:watch": "vitest --watch",
    "test:ci": "vitest --run --reporter=verbose",
    "clean": "rm -rf dist",
    "lint": "biome check src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format src/",
    "format:fix": "biome format --write src/",
    "check": "biome check src/",
    "check:fix": "biome check --write src/",
    "check:fix:unsafe": "biome check --write --unsafe src/",
    "checkpoint": "echo \"Checkpoint: @conflux-devkit/showcase-webapp - All checks passed\""
  },
  "dependencies": {
    "@conflux-devkit/core": "workspace:*",
    "@conflux-devkit/state-client": "workspace:*",
    "@conflux-devkit/state-server": "workspace:*",
    "@conflux-devkit/state-ui": "workspace:*",
    "@conflux-devkit/types": "workspace:*",
    "@headlessui/react": "^1.7.17",
    "@heroicons/react": "^2.0.18",
    "axios": "^1.12.2",
    "clsx": "^2.0.0",
    "date-fns": "^3.0.6",
    "immer": "^10.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/ui": "^2.1.9",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.10",
    "vitest": "^2.1.9"
  },
  "keywords": [
    "conflux",
    "blockchain",
    "showcase",
    "workspace",
    "dashboard",
    "devkit",
    "management"
  ],
  "author": "Conflux Development Team",
  "license": "MIT",
  "packageManager": "pnpm@10.11.0"
}