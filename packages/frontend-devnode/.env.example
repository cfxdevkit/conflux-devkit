# API Configuration
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3002

# WalletConnect Project ID (optional for local development)
# Get your project ID from: https://cloud.walletconnect.com/
# Without this, WalletConnect errors are automatically suppressed in development
# VITE_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Debug WalletConnect errors (set to "true" to see suppressed errors)
# VITE_DEBUG_WALLETCONNECT=false
