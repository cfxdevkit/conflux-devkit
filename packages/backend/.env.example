# Conflux DevKit - Backend environment example
# Copy this file to .env and fill values for local development.
# DO NOT commit real secrets into git. Keep .env in .gitignore.

# System mnemonic used to derive deployer/admin wallets.
# Preferred variable: HARDHAT_VAR_DEPLOYER_MNEMONIC
# Alternate/frontend alias: VITE_HARDHAT_VAR_DEPLOYER_MNEMONIC
# WARNING: Never commit your real mnemonic. Use a test mnemonic for local dev
# or set a secure mnemonic via environment variables on production deploys.
HARDHAT_VAR_DEPLOYER_MNEMONIC="test test test test test test test test test test test junk"
VITE_HARDHAT_VAR_DEPLOYER_MNEMONIC=""

# API base URL used by frontend to reach the backend (optional override)
VITE_API_BASE_URL="http://localhost:3001/api"

# JWT secret for signing access tokens. Change in production to a strong secret.
JWT_SECRET="conflux-devkit-secret-key-change-in-production"

# Optional: override numeric ports (API and WebSocket)
API_PORT=3001
API_WS_PORT=3002

# Optional runtime/debug flags
# Set to 'true' to enable debug features
DEBUG_MODE=false

# Node runtime flags used by the local Conflux node wrapper
NODE_SILENT_MODE=false

# Node environment: 'development', 'production', or 'test'
NODE_ENV=development

# Additional optional vars used across the repository (placeholders)
# Example: database connection string, if the backend is configured to use one
# DATABASE_URL=postgres://user:password@localhost:5432/devkit

# Note:
#  - To use your personal mnemonic locally, set HARDHAT_VAR_DEPLOYER_MNEMONIC in your shell
#    or paste it into a local .env file (ensure .env is gitignored).
#  - After editing .env, restart the backend process so dotenv picks up changes.
#  - The backend emits a warning if it falls back to the default test mnemonic.
