{
  "name": "@conflux-devkit/backend",
  "version": "0.1.0",
  "description": "Simplified backend services for Conflux DevKit - Clean API + WebSocket with DevKit integration",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "cfx-devkit": "./dist/bin.js",
    "conflux-devkit-backend": "./dist/index.js",
    "conflux-devkit-mcp": "./dist/mcp/bin.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server/BackendServer.js",
    "./auth": "./dist/auth/AuthService.js",
    "./services": "./dist/services/index.js",
    "./plugins": "./dist/plugins/index.js",
    "./mcp": {
      "import": "./dist/mcp/index.js",
      "types": "./dist/mcp/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "dev:cli": "tsx src/bin.ts",
    "start": "node dist/index.js",
    "cli": "node dist/bin.js",
    "test": "vitest run --pass-with-no-tests",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "conflux",
    "devkit",
    "backend",
    "api",
    "websocket"
  ],
  "author": "Conflux DevKit Team",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cfxdevkit/conflux-devkit.git",
    "directory": "packages/backend"
  },
  "homepage": "https://github.com/cfxdevkit/conflux-devkit#readme",
  "bugs": {
    "url": "https://github.com/cfxdevkit/conflux-devkit/issues"
  },
  "dependencies": {
    "@conflux-devkit/contracts": "workspace:*",
    "@conflux-devkit/core": "workspace:*",
    "@conflux-devkit/plugin-devnode": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "chalk": "^5.6.2",
    "cive": "^0.8.1",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "inquirer": "^13.2.0",
    "ora": "^9.0.0",
    "viem": "^2.43.3",
    "winston": "^3.19.0",
    "ws": "^8.18.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/inquirer": "^9.0.9",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^25.0.3",
    "@types/ws": "^8.5.12",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
