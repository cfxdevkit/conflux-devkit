{
  "name": "@conflux-devkit/contracts",
  "version": "0.1.0",
  "description": "Contract deployment and interaction utilities for Conflux - deploy, read, write, with standard ABIs",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./deployer": {
      "types": "./dist/deployer/index.d.ts",
      "import": "./dist/deployer/index.js",
      "require": "./dist/deployer/index.cjs"
    },
    "./interaction": {
      "types": "./dist/interaction/index.d.ts",
      "import": "./dist/interaction/index.js",
      "require": "./dist/interaction/index.cjs"
    },
    "./abis": {
      "types": "./dist/abis/index.d.ts",
      "import": "./dist/abis/index.js",
      "require": "./dist/abis/index.cjs"
    },
    "./compiler": {
      "types": "./dist/compiler/index.d.ts",
      "import": "./dist/compiler/index.js",
      "require": "./dist/compiler/index.cjs"
    },
    "./templates": {
      "types": "./dist/templates/index.d.ts",
      "import": "./dist/templates/index.js",
      "require": "./dist/templates/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "type-check": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "test": "vitest run --pass-with-no-tests",
    "test:ui": "vitest --ui",
    "test:run": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "test:watch": "vitest --watch",
    "clean": "rm -rf dist",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format src/",
    "format:fix": "biome format --write src/",
    "check": "biome check src/",
    "check:fix": "biome check --write src/"
  },
  "dependencies": {
    "@conflux-devkit/core": "workspace:*",
    "cive": "^0.8.1",
    "solc": "0.8.28",
    "viem": "^2.43.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "tsx": "^4.21.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "keywords": [
    "conflux",
    "blockchain",
    "contracts",
    "smart-contracts",
    "deployment",
    "abi",
    "evm",
    "erc20",
    "erc721",
    "erc1155"
  ],
  "author": "Conflux DevKit Team",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.11.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cfxdevkit/conflux-devkit.git",
    "directory": "packages/contracts"
  },
  "homepage": "https://github.com/cfxdevkit/conflux-devkit#readme",
  "bugs": {
    "url": "https://github.com/cfxdevkit/conflux-devkit/issues"
  }
}
