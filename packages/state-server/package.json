{
  "name": "@conflux-devkit/state-server",
  "version": "0.1.0",
  "description": "Server-side state management and API for Conflux DevKit applications",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "start": "node dist/index.js"
  },
  "keywords": [
    "conflux",
    "devkit",
    "state",
    "server",
    "api",
    "websocket"
  ],
  "author": "Conflux DevKit Team",
  "license": "MIT",
  "dependencies": {
    "@conflux-devkit/core": "workspace:*",
    "@conflux-devkit/blockchain": "workspace:*",
    "@conflux-devkit/types": "workspace:*",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "ws": "^8.14.2",
    "uuid": "^9.0.1",
    "zod": "^3.22.4",
    "zustand": "^4.4.7",
    "immer": "^10.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/ws": "^8.5.10",
    "@types/uuid": "^9.0.7",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
