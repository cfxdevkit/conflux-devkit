{
  "name": "@conflux-devkit/node",
  "version": "0.2.0",
  "description": "Conflux DevKit Node - Re-exports @conflux-devkit/core for production blockchain interaction (lightweight wrapper)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "echo \"Package deprecated - see @conflux-devkit/plugin-devnode\"",
    "build:watch": "tsup --watch",
    "type-check": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run --pass-with-no-tests",
    "test:ui": "vitest --ui",
    "test:run": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "test:watch": "vitest --watch",
    "clean": "rm -rf dist",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format src/",
    "format:fix": "biome format --write src/",
    "check": "biome check src/",
    "check:fix": "biome check --write src/"
  },
  "dependencies": {
    "@conflux-devkit/core": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@conflux-devkit/plugin-devnode": "workspace:*",
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "tsx": "^4.21.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "keywords": [
    "conflux",
    "blockchain",
    "node",
    "development",
    "testing",
    "evm",
    "core",
    "dual-chain"
  ],
  "author": "Conflux DevKit Team",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.11.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cfxdevkit/conflux-devkit.git",
    "directory": "packages/node"
  },
  "homepage": "https://github.com/cfxdevkit/conflux-devkit#readme",
  "bugs": {
    "url": "https://github.com/cfxdevkit/conflux-devkit/issues"
  }
}
